# --- Supabase (safe for the browser: these are the public anon credentials) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# The service-role key is intentionally NOT used by this app. Do not add it here.

# --- Resend (contact form email delivery) ---
# Server-only. Add in Vercel. Enquiries are emailed to shivcoolmaster@gmail.com.
RESEND_API_KEY=
# Optional: verified sender once a domain is set up in Resend
# (defaults to onboarding@resend.dev, which only delivers to the Resend account owner).
# RESEND_FROM=CoolMaster <enquiries@coolmaster.co.nz>

# --- Optional: Upstash Redis for login rate-limiting ---
# Leave unset to fall back to Supabase Auth's built-in rate limits.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
